{
  "name": "maatify/email-delivery",
  "description": "Standalone email delivery module for rendering, queueing and sending emails.",
  "type": "library",
  "license": "MIT",

  "keywords": [
    "email",
    "email-delivery",
    "email-queue",
    "smtp",
    "twig",
    "phpmailer",
    "transactional-email",
    "queue-worker"
  ],

  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "ext-pdo": "*",

    "maatify/crypto": "^1.0",
    "phpmailer/phpmailer": "^6.9",

    "twig/twig": "^3.0",
    "psr/log": "^3.0"
  },

  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^1.12",
    "friendsofphp/php-cs-fixer": "^3.94"
  },

  "autoload": {
    "psr-4": {
      "Maatify\\EmailDelivery\\": "src/"
    }
  },

  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },

  "scripts": {
    "test": "phpunit --colors=always",
    "analyse": "phpstan analyse src tests --level=max",
    "format": "php-cs-fixer fix"
  },

  "support": {
    "issues": "https://github.com/Maatify/email-delivery/issues",
    "source": "https://github.com/Maatify/email-delivery"
  },

  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "platform": {
      "php": "8.2.0"
    }
  },

  "minimum-stability": "stable",
  "prefer-stable": true
}